<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/klavyeKap"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:visibility="gone">

    <!--
        Klavye bloğu: sol=0, genişlik dinamik (ekran - panel genişliği),
        yükseklik ekranın 1/3'ü, ekranın altına yapışık.
        Gerçek boyut ve konum OzelKlavye.java içinde runtime'da hesaplanır.
    -->
    <LinearLayout
        android:id="@+id/klavyeIcKap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom|start"
        android:background="#EE1A0000"
        android:orientation="vertical"
        android:padding="4dp" />

</FrameLayout>
