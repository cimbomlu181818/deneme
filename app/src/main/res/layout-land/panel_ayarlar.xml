<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/panelScrollView"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:background="#FF0A1A3A"
        android:scrollbars="none"
        android:fadeScrollbars="true"
        android:fillViewport="false"
        android:paddingTop="58dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/Paneller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp" />

    </ScrollView>

    <LinearLayout
        android:id="@+id/listeMenuContainer"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:background="#FF0A1A3A"
        android:orientation="vertical"
        android:paddingTop="58dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/panelBaslik"
        android:layout_width="200dp"
        android:layout_height="58dp"
        android:layout_gravity="top|end"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="AYARLAR"
        android:textColor="#FFE8F0FF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#FF1A3A6A" />
    <!-- Çıkış Yap butonu -->
    <Button
        android:id="@+id/btnCikisYap"
        android:layout_width="200dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="58dp"
        android:text="Çıkış Yap"
        android:textSize="13sp"
        android:textColor="#FFEF5350"
        android:background="#FF1A3A6A"
        android:stateListAnimator="@null"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:visibility="gone" />

</FrameLayout>