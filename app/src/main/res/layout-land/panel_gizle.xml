<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gizlePanelContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/gizlePanelBaslik"
        android:layout_width="360dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="GİZLE / GÖSTER"
        android:textColor="#FFE8F0FF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#FF1A3A6A"
        android:elevation="4dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gizleRecyclerView"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginTop="56dp"
        android:background="#FF0A1A3A"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:fadeScrollbars="true" />

</FrameLayout>