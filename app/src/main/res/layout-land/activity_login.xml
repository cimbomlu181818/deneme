<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background_gradient">

    <!-- Marka satırı -->
    <LinearLayout
        android:id="@+id/brandRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_brand_play" />

        <TextView
            android:id="@+id/tvAppAdi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AZSH "
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="M3U "
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Player"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Ana kart -->
    <LinearLayout
        android:id="@+id/loginArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/login_area_background"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brandRow"
        app:layout_constraintWidth_max="700dp">

        <LinearLayout
            android:id="@+id/topRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- E-posta + Şifre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/input_field_background"
                    android:hint="E-posta"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_faint"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etSifre"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_field_background"
                    android:hint="Şifre"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_faint"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Giriş yap -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGirisYap"
                    android:layout_width="652dp"
                    android:layout_height="46dp"
                    android:background="@drawable/btn_primary_teal"
                    android:focusable="true"
                    android:stateListAnimator="@null"
                    android:text="Giriş yap"
                    android:textAllCaps="false"
                    android:textColor="@color/teal_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Kayıt ol / Şifremi unuttum -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnKayitOl"
                    android:layout_width="320dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/btn_ghost_outline"
                    android:focusable="true"
                    android:stateListAnimator="@null"
                    android:text="Kayıt ol"
                    android:textAllCaps="false"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/tvSifremiUnuttum"
                    android:layout_width="320dp"
                    android:layout_height="46dp"
                    android:background="@drawable/btn_ghost_outline"
                    android:focusable="true"
                    android:stateListAnimator="@null"
                    android:text="Şifremi unuttum?"
                    android:textAllCaps="false"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDestekOneri"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Destek, öneri veya her türlü konu için azsh181818@gmail.com adresine mail atabilirsiniz."
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Google butonu (kodda her zaman gizleniyor) -->
        <Button
            android:id="@+id/btnGoogle"
            android:layout_width="209dp"
            android:layout_height="34dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_ghost_outline"
            android:drawableStart="@drawable/ic_google"
            android:drawablePadding="8dp"
            android:stateListAnimator="@null"
            android:text="Google ile Giriş"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Hata mesajı -->
        <TextView
            android:id="@+id/tvHata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/error_bg"
            android:gravity="center"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/error_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Deneme süresi bitti uyarısı -->
        <LinearLayout
            android:id="@+id/layoutTrialUyari"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvUyariSolIkon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="1dp"
                    android:text="⚠"
                    android:textColor="@color/gold"
                    android:textSize="17sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="3dp"
                        android:text="Deneme süreniz sona erdi"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTrialBittiMesaji"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text=""
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvUyariSagIkon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/divider_line" />

            <!-- Ödeme onay notu (sadece deneme süresi bittiğinde görünür) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Ödeme onaylandıktan sonra bu ekranı görmeye devam ediyorsan destek e-postasına dekontunla birlikte yaz."
                android:textColor="@color/text_faint"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ProgressBar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/gold"
            android:visibility="gone" />

        <!-- Trial bilgisi -->
        <TextView
            android:id="@+id/tvTrialBilgisi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="✓ 1 gün ücretsiz deneme"
            android:textColor="@color/teal"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Premium bilgi bloğu -->
        <LinearLayout
            android:id="@+id/tvPremiumBilgisi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Başlık + fiyat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Premium üyelik"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₺100"
                        android:textColor="@color/gold"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginBottom="2dp"
                        android:text="/ay"
                        android:textColor="@color/text_faint"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Özellikler -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="✓ 2 cihaza kadar kullanım"
                    android:textColor="@color/teal"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ 12 saat içinde aktif"
                    android:textColor="@color/teal"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/divider_line" />

            <!-- IBAN kutusu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/payment_box_background"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="IBAN"
                    android:textColor="@color/text_faint"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvIbanDeger"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="TR00 0000 0000 0000 0000 0000 00"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnIbanKopyala"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/iban_copy_button_background"
                        android:minWidth="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:stateListAnimator="@null"
                        android:text="Kopyala"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/divider_line_dashed" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alıcı: AD SOYAD"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════════════════
             Doğrulama paneli — başta gizli, kayıt/doğrulanmamış girişte gösterilir
             ══════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutDogrulama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✉"
                android:textSize="36sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDogrulamaEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />
            <EditText
                android:id="@+id/etDogrulamaKodu"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/input_field_background"
                android:hint="6 haneli kod"
                android:inputType="number"
                android:maxLength="6"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_faint"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnKoduOnayla"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_primary_teal"
                android:stateListAnimator="@null"
                android:text="✔  Kodu onayla"
                android:textAllCaps="false"
                android:textColor="@color/teal_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTekrarGonder"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_ghost_outline"
                android:stateListAnimator="@null"
                android:text="📨  Doğrulama mailini tekrar gönder"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnGirisEkraninaGeri"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"
                android:text="← Giriş ekranına dön"
                android:textAllCaps="false"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════════════════
             Şifremi Unuttum paneli — başta gizli
             ══════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutSifremiUnuttum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔑"
                android:textSize="36sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSifreSifirlamaBilgi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Şifrenizi sıfırlamak için email adresinizi girin."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etSifreUnutEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/input_field_background"
                android:hint="E-posta"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_faint"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnKodGonder"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_primary_teal"
                android:stateListAnimator="@null"
                android:text="Kod Gönder"
                android:textAllCaps="false"
                android:textColor="@color/teal_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSifreSifirlamaGeri"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"
                android:text="← Giriş ekranına dön"
                android:textAllCaps="false"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════════════════
             Yeni Şifre Belirleme paneli — başta gizli, kod gönderildikten sonra gösterilir
             ══════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutYeniSifre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="36sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="E-postanıza gönderdiğimiz kodu ve yeni şifrenizi girin."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etSifirlamaKodu"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/input_field_background"
                android:hint="6 haneli kod"
                android:inputType="number"
                android:maxLength="6"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_faint"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etYeniSifre"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/input_field_background"
                android:hint="Yeni şifre (en az 6 karakter)"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_faint"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etYeniSifreTekrar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/input_field_background"
                android:hint="Yeni şifre (tekrar)"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_faint"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSifreyiSifirla"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_primary_teal"
                android:stateListAnimator="@null"
                android:text="Şifreyi Sıfırla"
                android:textAllCaps="false"
                android:textColor="@color/teal_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnYeniSifreGeri"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:stateListAnimator="@null"
                android:text="← Giriş ekranına dön"
                android:textAllCaps="false"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>


    <TextView
        android:id="@+id/tvTrialDolduBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠ Deneme süreniz doldu. Lütfen iletişime geçin."
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="12dp"
        android:background="#CCEF5350"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>