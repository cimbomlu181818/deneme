<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <!-- Başlık -->
    <TextView
        android:id="@+id/tvTermsBaslik"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="Kullanıcı Sorumluluk Beyanı ve Kullanım Şartları"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Sözleşme metni -->

    <ScrollView
        android:id="@+id/scrollTerms"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/btnReddet"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/scroll_terms_background"
        android:padding="18dp"
        app:layout_constraintBottom_toTopOf="@id/buttonRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTermsBaslik"
        app:layout_constraintWidth_max="900dp">

        <TextView
            android:id="@+id/tvTermsMetin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </ScrollView>

    <!-- Butonlar -->
    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="900dp">

        <Button
            android:id="@+id/btnReddet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/secondary_button_background"
            android:padding="14dp"
            android:text="Reddet"
            android:textColor="@color/text_muted"
            android:focusable="true"
            android:nextFocusUp="@id/scrollTerms"
            android:nextFocusRight="@id/btnKabulEt" />

        <Button
            android:id="@+id/btnKabulEt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/primary_button_background"
            android:padding="14dp"
            android:text="Kabul Ediyorum"
            android:textColor="@color/teal_text"
            android:textStyle="bold"
            android:focusable="true"
            android:nextFocusUp="@id/scrollTerms"
            android:nextFocusLeft="@id/btnReddet" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>