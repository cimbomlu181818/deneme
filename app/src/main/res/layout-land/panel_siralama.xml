<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/siralamaBaslik"
        android:layout_width="380dp"
        android:layout_height="52dp"
        android:layout_gravity="top|start"
        android:paddingStart="20dp"
        android:gravity="center_vertical"
        android:text="SIRALAMA PANELİ"
        android:textColor="#FFE8F0FF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="#FF1A3A6A"
        android:focusable="false" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/siralamaRecyclerView"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginTop="52dp"
        android:background="#FF0A1A3A"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        android:scrollbars="none"
        android:focusable="true"
        android:descendantFocusability="afterDescendants" />

    <TextView
        android:id="@+id/siralamaYardim"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="10dp"
        android:text="▶ Sağ=Seç  ◀ Sol=Seçimi kaldır  OK=Taşı/Aç"
        android:textColor="#CCB4D2F0"
        android:textSize="13sp"
        android:focusable="false" />

</FrameLayout>