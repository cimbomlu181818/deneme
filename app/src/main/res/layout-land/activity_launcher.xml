<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#1C1C2E">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📺 LiveTV"
        android:textColor="#E0E0F0"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/btnKumanda"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="🎮  Uzaktan Kumanda"
        android:textSize="16sp"
        android:textColor="#E0E0F0"
        android:background="@drawable/rounded_rect"
        android:backgroundTint="#2E2E50"
        android:layout_marginBottom="16dp"
        android:elevation="3dp" />

    <Button
        android:id="@+id/btnDosyaYoneticisi"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="📁  Dosya Yöneticisi"
        android:textSize="16sp"
        android:textColor="#E0E0F0"
        android:background="@drawable/rounded_rect"
        android:backgroundTint="#2E2E50"
        android:layout_marginBottom="16dp"
        android:elevation="3dp" />

    <Button
        android:id="@+id/btnPlayer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="▶  M3U Player"
        android:textSize="16sp"
        android:textColor="#E0E0F0"
        android:background="@drawable/rounded_rect"
        android:backgroundTint="#2E2E50"
        android:elevation="3dp" />

</LinearLayout>