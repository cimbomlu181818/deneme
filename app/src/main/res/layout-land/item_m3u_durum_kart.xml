<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_rect"
    android:layout_marginBottom="10dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="afterDescendants">

    <!-- ── Üst satır: M3U adı + Durum etiketi ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvM3UAdi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvDurum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF" />

    </LinearLayout>

    <!-- ── Ayırıcı ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1A28" />

    <!-- ── Son güncelleme zamanı ── -->
    <TextView
        android:id="@+id/tvSonGuncelleme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textSize="10sp"
        android:textColor="#FFFFFFFF"
        android:fontFamily="monospace" />

    <!-- ── Ayırıcı ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1A28" />

    <!-- ── Metrik satırı: Bağlantı / Bitiş / Kanal ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:baselineAligned="false">

        <!-- Bağlantı -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BAĞLANTI"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvBaglanti"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:fontFamily="monospace" />

        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1A1A28" />

        <!-- Bitiş tarihi -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BİTİŞ"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvBitis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:fontFamily="monospace" />

        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1A1A28" />

        <!-- Kanal sayısı -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KANAL"
                android:textSize="9sp"
                android:textColor="#FFFFFFFF"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvKanalSayisi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:fontFamily="monospace" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Ayırıcı ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1A28" />

    <!-- ── Sunucu / Kullanıcı / Oluşturma bilgileri ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sunucu"
                android:textSize="11sp"
                android:textColor="#FFFFFFFF"
                android:minWidth="80dp" />

            <TextView
                android:id="@+id/tvSunucu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="#FFFFFFFF"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kullanıcı"
                android:textSize="11sp"
                android:textColor="#FFFFFFFF"
                android:minWidth="80dp" />

            <TextView
                android:id="@+id/tvKullanici"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="#FFFFFFFF"
                android:fontFamily="monospace" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oluşturma"
                android:textSize="11sp"
                android:textColor="#FFFFFFFF"
                android:minWidth="80dp" />

            <TextView
                android:id="@+id/tvOlusturulma"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:textColor="#FFFFFFFF"
                android:fontFamily="monospace" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Ayırıcı ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1A28" />

    <!-- ── Hata mesajı (Xtream değilse) ── -->
    <TextView
        android:id="@+id/tvHata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textSize="11sp"
        android:textColor="#FFFFFFFF"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- ── Dosya uyarısı (isLocalFile=true ise) ── -->
    <TextView
        android:id="@+id/tvDosyaUyari"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="📁 Dosyadan yüklendi — güncellenemez"
        android:textSize="11sp"
        android:textColor="#FFFFFFFF"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- ── Footer: Güncelle + İsim Değiştir + Sonuç ── -->
    <LinearLayout
        android:id="@+id/kartFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <Button
            android:id="@+id/btnGuncelle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="↻ Güncelle"
            android:textSize="11sp"
            android:textColor="#FFE50914"
            android:background="#1AE50914"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnIsmDegistir"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="✎ İsim Değiştir"
            android:textSize="11sp"
            android:textColor="#FF5578FF"
            android:background="#1A5578FF"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:stateListAnimator="@null" />

        <TextView
            android:id="@+id/tvGuncelleSonuc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="10sp"
            android:textColor="#88FFFFFF"
            android:fontFamily="monospace"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>