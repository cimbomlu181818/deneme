<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/m3uDurumContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/m3uDurumBaslik"
        android:layout_width="480dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="M3U DURUMU"
        android:textColor="#FFE8F0FF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#FF1A3A6A"
        android:focusable="false" />

    <Button
        android:id="@+id/btnTumunuGuncelle"
        android:layout_width="480dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="48dp"
        android:text="↻ Tümünü Güncelle"
        android:textSize="13sp"
        android:textColor="#FFE50914"
        android:background="#1AE50914"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:stateListAnimator="@null" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/m3uDurumRecyclerView"
        android:layout_width="480dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginTop="92dp"
        android:background="#FF0A1A3A"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="20dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none"
        android:focusable="true"
        android:descendantFocusability="afterDescendants" />

</FrameLayout>