<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="#1a1b2f">

    <!-- Üst satır: ikon + dosya adı + durum -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <!-- Dosya ikonu -->
        <ImageView
            android:id="@+id/ivDosyaIkon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_send"
            android:layout_marginEnd="10dp"
            android:focusable="false" />

        <!-- Dosya adı -->
        <TextView
            android:id="@+id/tvDosyaAd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#eeeeff"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="middle"
            android:focusable="false" />

        <!-- Durum etiketi: Bekliyor / %65 / ✓ Tamam / ✗ Hata -->
        <TextView
            android:id="@+id/tvDosyaDurum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:layout_marginStart="8dp"
            android:focusable="false" />

    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/pbDosya"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#4FC3F7"
        android:progressBackgroundTint="#2a2b3f" />

</LinearLayout>