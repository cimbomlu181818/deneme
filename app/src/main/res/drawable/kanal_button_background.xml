<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ana buton gradienti -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF2A5272"
                android:centerColor="#FF1A3A5A"
                android:endColor="#FF0A2A42"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#80325882" />
            <solid android:color="#00000000" />
        </shape>
    </item>

    <!-- Sol kenarlık vurgusu - ince, yarı saydam mavi -->
    <item android:left="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#405A8AB0" />
            <size android:width="3dp" />
            <corners android:radius="14dp" />
        </shape>
    </item>

</layer-list>