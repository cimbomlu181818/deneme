<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Panel arka planı - DÜZ KÖŞE (oval YOK) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF1E3A5A"
                android:centerColor="#FF0A2A4A"
                android:endColor="#FF041A2A"
                android:type="linear" />
            <corners android:radius="0dp" />
            <stroke
                android:width="1dp"
                android:color="#80325882" />
        </shape>
    </item>

    <!-- Üst metalik parlaklık efekti -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#305078A0"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="0dp" />
        </shape>
    </item>

</layer-list>