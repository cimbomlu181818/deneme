<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focus durumu: turuncu çerçeve + hafif parlaklık -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2C4A6A" />
            <corners android:radius="40dp" />
            <stroke android:width="2dp" android:color="#FF6B2C" />
        </shape>
    </item>
    <!-- Basılı durum -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A3A5A" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <!-- Normal durum -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#11161F" />
            <corners android:radius="40dp" />
            <stroke android:width="1dp" android:color="#2C3444" />
        </shape>
    </item>
</selector>