<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A3444" />  <!-- daha açık, kontrastlı -->
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="#FF6B2C" />
            <!-- opsiyonel: iç glow efekti -->
            <padding android:bottom="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E2532" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#2C3444" />
        </shape>
    </item>
</selector>